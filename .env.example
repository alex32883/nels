# Required. The password used on the login screen (all devices share this).
NELS_PASSWORD=choose-a-strong-password

# Optional. Used to sign the login cookie. If omitted, NELS_PASSWORD is used.
NELS_SESSION_SECRET=

# Required on Vercel so every browser shares the same notes, tasks, and events.
# Easiest: Vercel Dashboard → Storage → Create Database → Upstash Redis
# (fills these automatically). Locally, copy them into .env.local too if you want
# localhost to match the Vercel data.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Upstash’s own names also work:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
